# Vibes Desktop — environment example
# Copy to .env (gitignored). Keys here are for the DEV machine only;
# in-app role keys still live in OS safeStorage — this file is for process env
# (VIBES_PATH, LAN decision MCP, optional Ollama defaults).

# OpenAI-compatible endpoint used by the vibes child (Roles → Executor wins over these)
# Example: Unsloth Studio on LAN (AgentWorld / Qwen GGUF)
OLLAMA_BASE_URL=http://192.168.5.157:8888/v1
OLLAMA_MODEL=unsloth/Qwen-AgentWorld-35B-A3B-GGUF
OLLAMA_API_KEY=
# Prefer Roles tab for per-role keys (encrypted). Dev-only fallback:
# OLLAMA_API_KEY=sk-unsloth-…

# Optional: point at a local vibes checkout (first-run wizard / Settings also set this)
# VIBES_PATH=C:/Users/steph/Documents/development/vibes

# KEV / Unsloth Decision MCP (Settings → Decision also stores URL+token encrypted)
# LAN clients should use KEV_MCP_URL — :8008/:8009 are often localhost-only on the host.
# KEV_API_BASE_URL=http://192.168.5.157:8008
# KEV_API_KEY=
# KEV_MCP_URL=http://192.168.5.157:8765/mcp
# KEV_MCP_AUTH_TOKEN=
# Unsloth Studio example: KEV_MCP_URL=http://192.168.5.157:8888/mcp/
# GUTSY_API_BASE_URL=http://192.168.5.157:8009

# Live tests (optional)
# VIBES_LIVE=1
# VIBES_DECISION_LIVE=1

# Code signing for npm run dist (public beta) — see docs/PACKAGING.md
# CSC_LINK=C:/secure/vibes-desktop.pfx
# CSC_KEY_PASSWORD=
