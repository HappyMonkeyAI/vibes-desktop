{
  "name": "vibes-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Focused desktop app for orchestrating Vibes missions: voice input, live activity ledger, mission control UI.",
  "author": "HappyMonkey / FerroxLabs",
  "homepage": "https://github.com/SPhillips1337/vibes-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/SPhillips1337/vibes-desktop.git"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.ferrox.vibesdesktop",
    "productName": "Vibes Desktop",
    "copyright": "Copyright © HappyMonkey / FerroxLabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "forceCodeSigning": false,
    "icon": "build/icon.ico",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Vibes Desktop Setup ${version}.${ext}"
    }
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.18",
    "@huggingface/transformers": "^4.3.1",
    "@icon-park/react": "^1.4.2",
    "electron-store": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unocss": "^66.11.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
